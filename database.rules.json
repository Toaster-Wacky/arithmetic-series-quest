{
  "rules": {
    ".read": false,
    ".write": false,

    "rooms": {
      "$roomCode": {
        ".read": true,

        "groups": {
          ".write": "!newData.exists()",

          "$groupId": {
            ".write": "$groupId.matches(/^group-[1-6]$/)",

            "name":         { ".validate": "newData.isString() && newData.val().length <= 40" },
            "status":       { ".validate": "newData.val() == 'idle' || newData.val() == 'playing' || newData.val() == 'finished'" },
            "currentIndex": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100" },
            "currentStep":  { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 20" },
            "totalScore":   { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 10000" },
            "hearts":       { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 10" },
            "updatedAt":    { ".validate": "newData.isNumber()" },
            "finishedAt":   { ".validate": "newData.isNumber()" },

            "progress": {
              "$questionId": {
                "order":      { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100" },
                "title":      { ".validate": "newData.isString() && newData.val().length <= 80" },
                "status":     { ".validate": "newData.val() == 'in_progress' || newData.val() == 'solved' || newData.val() == 'revealed'" },
                "stepIndex":  { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 20" },
                "stepTotal":  { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 20" },
                "wrongCount": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 50" },
                "hintCount":  { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 50" },
                "score":      { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 1000" },
                "finishedAt": { ".validate": "newData.isNumber()" },

                "wrongAnswers": {
                  "$index": { ".validate": "newData.isString() && newData.val().length <= 120" }
                },

                "stepLog": {
                  "$index": {
                    "answerText": { ".validate": "newData.isString() && newData.val().length <= 120" },
                    "hinted":     { ".validate": "newData.isBoolean()" },
                    "$other":     { ".validate": false }
                  }
                },

                "$other": { ".validate": false }
              }
            },

            "$other": { ".validate": false }
          }
        },

        "$other": { ".validate": false }
      }
    }
  }
}
