#!/bin/bash
# =====================================================================
#  ตัวเปิดเกม "ภารกิจตะลุยโจทย์อนุกรมเลขคณิต"
#  ---------------------------------------------------------------
#  วิธีใช้ : ดับเบิลคลิกไฟล์นี้ได้เลย
#
#  ทำไมต้องมีไฟล์นี้ :
#  เว็บแอปนี้เขียนด้วย ES Modules ซึ่งเบราว์เซอร์จะบล็อกเมื่อเปิดไฟล์
#  โดยตรงแบบ file:// (จะเห็นหน้าว่าง ๆ ไม่มีปุ่ม) จึงต้องเปิดผ่าน
#  เว็บเซิร์ฟเวอร์เล็ก ๆ ในเครื่อง ไฟล์นี้ทำหน้าที่นั้นให้อัตโนมัติ
#
#  ปิดเซิร์ฟเวอร์ : กด Ctrl + C ในหน้าต่าง Terminal นี้ หรือปิดหน้าต่างไปเลย
# =====================================================================

# ย้ายไปยังโฟลเดอร์ที่ไฟล์นี้อยู่ เพื่อให้เสิร์ฟไฟล์ของโครงการได้ถูกต้อง
cd "$(dirname "$0")" || exit 1

# ตรวจว่ามี python3 ในเครื่องหรือไม่ (macOS รุ่นใหม่มีมาให้อยู่แล้ว)
if ! command -v python3 >/dev/null 2>&1; then
  echo ""
  echo "  ไม่พบ python3 ในเครื่องนี้"
  echo "  กรุณาติดตั้ง Xcode Command Line Tools ด้วยคำสั่ง:  xcode-select --install"
  echo ""
  read -r -p "  กด Enter เพื่อปิดหน้าต่าง..."
  exit 1
fi

# หาพอร์ตว่างตัวแรกจากรายการที่ต้องการ ถ้าไม่ว่างเลยให้ระบบเลือกให้เอง
PORT=$(python3 - <<'PY'
import socket
for candidate in (8000, 8001, 8080, 8765, 0):
    probe = socket.socket()
    try:
        probe.bind(('127.0.0.1', candidate))
        print(probe.getsockname()[1])
        probe.close()
        break
    except OSError:
        probe.close()
PY
)

URL="http://localhost:${PORT}"

echo ""
echo "  ============================================================"
echo "   ภารกิจตะลุยโจทย์อนุกรมเลขคณิต"
echo "  ============================================================"
echo ""
echo "   เปิดเบราว์เซอร์ที่  ${URL}"
echo ""
echo "   หน้านักเรียน : ${URL}/student.html"
echo "   กระดานครู    : ${URL}/teacher.html"
echo ""
echo "   ปิดเซิร์ฟเวอร์ด้วยการกด Ctrl + C หรือปิดหน้าต่างนี้"
echo "  ============================================================"
echo ""

# เปิดเบราว์เซอร์หลังเซิร์ฟเวอร์พร้อมทำงาน (หน่วง 1 วินาที)
( sleep 1; open "${URL}" ) &

# รันเซิร์ฟเวอร์ค้างไว้ ผูกกับ 127.0.0.1 เพื่อไม่ให้เครื่องอื่นในวงเน็ตเข้าถึง
python3 -m http.server "${PORT}" --bind 127.0.0.1
